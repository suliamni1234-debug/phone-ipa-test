<?xml version="1.0" encoding="utf-8"?>
<!-- Heads-up banner card: deep blue gradient, big radius, hairline border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FF2E7CF6"
        android:centerColor="#FF1A55C4"
        android:endColor="#FF0F2D6B" />
    <corners android:radius="28dp" />
    <stroke android:width="1dp" android:color="#40FFFFFF" />
</shape>
