<?xml version="1.0" encoding="utf-8"?>
<!--
  Heads-up notification-style caller-ID banner pinned to the top of the
  screen (like a system alert). Info-only: name/photo/number/status — the
  system incoming-call UI below handles Answer/Decline. Tapping the card
  opens the app on the number's info screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="40dp">

    <LinearLayout
        android:id="@+id/overlay_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/overlay_banner_bg"
        android:elevation="12dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp">

        <!-- Brand row: app identity + close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/overlay_brand_dot" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Yellow Fast Call · Incoming call"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/overlay_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="-8dp"
                android:layout_marginTop="-6dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#B3FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Caller row: photo + name/number/status. Tapping opens the app. -->
        <LinearLayout
            android:id="@+id/overlay_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="10dp">

            <FrameLayout
                android:id="@+id/overlay_avatar"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/overlay_avatar_bg"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/overlay_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="Caller photo" />

                <TextView
                    android:id="@+id/overlay_initials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:text="?" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/overlay_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Searching…"
                    android:textColor="#FFFFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overlay_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text=""
                    android:textColor="#D9FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
